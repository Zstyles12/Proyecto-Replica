# Variables de entorno de la web. Copia este archivo como `.env.local` y llénalo; ese no se sube.
# Hoy la web funciona sin ninguna: todo es simulado (Etapa A de docs/04-plan.md).
# En la Etapa B se conecta al proyecto de Supabase compartido con la app.

# Proyecto de Supabase (Settings → API). La clave pública es segura en el navegador:
# los datos los protegen las reglas de acceso (RLS), no esta clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La clave de Gemini NUNCA va aquí: las réplicas salen de las Edge Functions compartidas.
