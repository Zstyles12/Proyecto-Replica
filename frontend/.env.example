# Variables de entorno de la web. Copia este archivo como `.env.local` y llénalo; ese no se sube.
# Sin ellas, la web funciona con los servicios simulados.

# Proyecto de Supabase (Settings → API). La clave pública (publishable o anon) es segura en el
# navegador: los datos los protegen las reglas de acceso (RLS), no esta clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID del recordatorio diario (supabase/README.md). Sin ella, el recordatorio no se
# muestra. La privada NUNCA va aquí.
VITE_VAPID_PUBLIC_KEY=

# La clave de Gemini NUNCA va aquí: es un secreto de las Edge Functions.
