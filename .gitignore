# Único .gitignore del proyecto: vale para la raíz y para frontend/.

# Dependencias
node_modules/

# Builds de producción (se generan con npm run build)
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Variables de entorno y claves (Supabase, Gemini...)
.env
.env.*
!.env.example

# Supabase local (cuando exista el backend: lo que genera la CLI, no las migraciones)
supabase/.branches/
supabase/.temp/
supabase/.env

# Despliegue (Vercel o Netlify guardan aquí el enlace con el proyecto)
.vercel/
.netlify/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Pruebas y reportes generados
coverage/
playwright-report/
test-results/
lighthouse-report*

# Editor y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
*.local
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
desktop.ini

# Entregas de clase (no son parte de la web)
entrega-evaluacion-3/
sistematizacion/

# Notas de traspaso entre sesiones (no se suben)
RETOMAR.md

# Ajustes locales de los agentes y herramientas
# (.claude/launch.json sí se sube: levanta el servidor de desarrollo y el de vista previa)
.claude/settings.local.json
.antiagent.json
